# ============================================
# Configurações do Ambiente - EXEMPLO
# Copie este arquivo para .env e preencha
# ============================================

# Chave secreta da aplicação Flask
CHAVE_SECRETA=alterar-para-uma-chave-segura

# Banco de Dados MySQL
MYSQL_HOST=localhost
MYSQL_USUARIO=seu_usuario
MYSQL_SENHA=sua_senha
MYSQL_BANCO=app_pontointerno

# Servidor de Email (SMTP)
EMAIL_SERVIDOR=smtp.gmail.com
EMAIL_PORTA=587
EMAIL_USAR_TLS=true
EMAIL_USUARIO=seu_email@dominio.com
EMAIL_SENHA=sua_senha_de_app
EMAIL_REMETENTE=seu_email@dominio.com

# Modo debug (true/false)
FLASK_DEBUG=true

# Porta da aplicação
FLASK_PORTA=5001
